    "## Ejercicio 12. Control de ingresos y egresos  `R`\n",
    "Capacidad de 15 vehículos. Registrar ingreso/salida, consultar placas, cuántos hay y cuántos espacios quedan; evitar ingresos con el estacionamiento lleno y salidas de placas no registradas."
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# Ejercicio 12. Control de ingresos y egresos\n",
    "CAPACIDAD = 15\n",
    "def leer_entero(mensaje, minimo, maximo):\n",
    "    \"\"\"Pide un entero entre minimo y maximo (inclusive).\"\"\"\n",
    "    while True:\n",
    "        try:\n",
    "            valor = int(input(mensaje))\n",
    "            if minimo <= valor <= maximo:\n",
    "                return valor\n",
    "        except ValueError:\n",
    "            pass\n",
    "        print(f\"  ⚠ Ingresa un número entero entre {minimo} y {maximo}.\")\n",
    "dentro = []   # placas de los vehículos que están actualmente en el estacionamiento\n",
    "\n",
    "while True:\n",
    "    print(\"\\n1) Registrar ingreso      2) Registrar salida\")\n",
    "    print(\"3) Consultar placas       4) Vehículos estacionados\")\n",
    "    print(\"5) Espacios disponibles   0) Salir\")\n",
    "    opcion = leer_entero(\"Opción: \", 0, 5)\n",
    "\n",
    "    if opcion == 0:\n",
    "        break\n",
    "\n",
    "    elif opcion == 1:\n",
    "        if len(dentro) >= CAPACIDAD:\n",
    "            print(\"  ⛔ Estacionamiento lleno: no se permite el ingreso.\")\n",
    "        else:\n",
    "            placa = input(\"Placa: \").strip().upper()\n",
    "            if placa in dentro:\n",
    "                print(f\"  ⚠ La placa {placa} ya está registrada dentro.\")\n",
    "            else:\n",
    "                dentro.append(placa)\n",
    "                print(f\"  ✔ Ingreso registrado: {placa}\")\n",
    "\n",
    "    elif opcion == 2:\n",
    "        placa = input(\"Placa: \").strip().upper()\n",
    "        if placa in dentro:\n",
    "            dentro.remove(placa)\n",
    "            print(f\"  ✔ Salida registrada: {placa}\")\n",
    "        else:\n",
    "            print(f\"  ⚠ La placa {placa} no está registrada en el estacionamiento.\")\n",
    "\n",
    "    elif opcion == 3:\n",
    "        if len(dentro) == 0:\n",
    "            print(\"  El estacionamiento está vacío.\")\n",
    "        for numero, placa in enumerate(dentro, start=1):\n",
    "            print(f\"  {numero}. {placa}\")\n",
    "\n",
    "    elif opcion == 4:\n",
    "        print(f\"  Vehículos estacionados: {len(dentro)}\")\n",
    "\n",
    "    else:\n",
    "        print(f\"  Espacios disponibles: {CAPACIDAD - len(dentro)}\")"
   ],
   "execution_count": null,
   "outputs": []
  },
