    "# Ejercicio 11. Búsqueda de vehículos\n",
    "def confirmar(mensaje):\n",
    "    \"\"\"Regresa True si el usuario responde que sí.\"\"\"\n",
    "    return input(f\"{mensaje} (s/n): \").strip().lower() in (\"s\", \"si\", \"sí\")\n",
    "historial = []\n",
    "while True:\n",
    "    historial.append(input(\"Placa a guardar: \").strip().upper())\n",
    "    if not confirmar(\"¿Guardar otra placa?\"):\n",
    "        break\n",
    "\n",
    "print(\"\\n--- Consulta de historial ---\")\n",
    "while True:\n",
    "    buscada = input(\"Placa a buscar: \").strip().upper()\n",
    "\n",
    "    posicion = -1\n",
    "    for i in range(len(historial)):          # recorrer y comparar\n",
    "        if historial[i] == buscada:\n",
    "            posicion = i\n",
    "            break\n",
    "\n",
    "    if posicion == -1:\n",
    "        print(f\"  La placa {buscada} NO está en el historial.\")\n",
    "    else:\n",
    "        print(f\"  La placa {buscada} SÍ estuvo: posición {posicion + 1} de {len(historial)}.\")\n",
    "\n",
    "    if not confirmar(\"¿Buscar otra placa?\"):\n",
    "        break"
   ],
