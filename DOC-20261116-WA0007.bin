   "source": [
    "## Ejercicio 19. Reporte de ocupación e ingresos  `C` (continúa el ejercicio 18)\n",
    "Se agrega el reporte final: vehículos dentro, espacios libres/ocupados, total atendidos, ingresos, tipo con más ingresos y fila con mayor ocupación.\n",
    "\n",
    "> **Nota:** \"atendidos\" cuenta todos los vehículos que ingresaron durante la jornada. Si hay empate (tipo o fila), se muestran todos los empatados."
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# Ejercicio 19. Reporte de ocupación e ingresos  (ejercicio 18 + reporte)\n",
    "import math\n",
    "\n",
    "# ---------------- Datos ----------------\n",
    "LIBRE = \"LIBRE\"\n",
    "FILAS, COLUMNAS = 3, 3\n",
    "TIPOS = {1: \"Motocicleta\", 2: \"Automóvil\", 3: \"Camioneta\", 4: \"Camión\"}\n",
    "TARIFAS = {\"Motocicleta\": 10, \"Automóvil\": 15, \"Camioneta\": 20, \"Camión\": 30}\n",
    "\n",
    "estacionamiento = [[LIBRE] * COLUMNAS for _ in range(FILAS)]   # matriz de placas (ejercicio 17)\n",
    "registros = []   # historial: un diccionario por vehículo (placa, tipo, entrada, salida...)\n",
    "\n",
    "# ---------------- Utilidades ----------------\n",
    "def leer_entero(mensaje, minimo, maximo):\n",
    "    \"\"\"Pide un entero entre minimo y maximo (inclusive).\"\"\"\n",
    "    while True:\n",
    "        try:\n",
    "            valor = int(input(mensaje))\n",
    "            if minimo <= valor <= maximo:\n",
    "                return valor\n",
    "        except ValueError:\n",
    "            pass\n",
    "        print(f\"  ⚠ Ingresa un número entero entre {minimo} y {maximo}.\")\n",
    "def leer_hora(mensaje, minimo=0):\n",
    "    \"\"\"Pide una hora HH:MM (24 h) y la regresa en minutos desde medianoche.\n",
    "    Rechaza horas anteriores a `minimo`.\"\"\"\n",
    "    while True:\n",
    "        try:\n",
    "            horas, minutos = map(int, input(mensaje).strip().split(\":\"))\n",
    "            if 0 <= horas <= 23 and 0 <= minutos <= 59:\n",
    "                total = horas * 60 + minutos\n",
    "                if total >= minimo:\n",
    "                    return total\n",
    "                print(\"  ⚠ La hora no puede ser anterior a la de entrada.\")\n",
    "                continue\n",
    "        except ValueError:\n",
    "            pass\n",
    "        print(\"  ⚠ Formato inválido. Usa HH:MM (ej. 08:30).\")\n",
    "def formato_hora(minutos):\n",
    "    return f\"{minutos // 60:02d}:{minutos % 60:02d}\"\n",
    "\n",
    "\n",
    "def formato_duracion(minutos):\n",
    "    return f\"{minutos // 60} h {minutos % 60:02d} min\"\n",
    "\n",
    "\n",
    "# ---------------- Operaciones ----------------\n",
    "def mostrar_estacionamiento(matriz):\n",
    "    print(\"        \" + \"\".join(f\"Esp.{c:<7}\" for c in range(1, len(matriz[0]) + 1)))\n",
    "    for i in range(len(matriz)):\n",
    "        print(f\"Fila {i + 1}  \", end=\"\")\n",
    "        for j in range(len(matriz[i])):\n",
    "            print(f\"{matriz[i][j]:<11}\", end=\"\")\n",
    "        print()\n",
    "\n",
    "\n",
    "def buscar_placa(matriz, placa):\n",
    "    \"\"\"Regresa (fila, columna) de la placa o None.\"\"\"\n",
    "    for i in range(len(matriz)):\n",
    "        for j in range(len(matriz[i])):\n",
    "            if matriz[i][j] == placa:\n",
    "                return i, j\n",
    "    return None\n",
    "\n",
    "\n",
    "def registrar_entrada(matriz, registros):\n",
    "    placa = input(\"Placa: \").strip().upper()\n",
    "    if placa == \"\" or placa == LIBRE:\n",
    "        print(\"  ⚠ Placa no válida.\")\n",
    "        return\n",
    "    if buscar_placa(matriz, placa) is not None:\n",
    "        print(f\"  ⚠ La placa {placa} ya se encuentra dentro.\")\n",
    "        return\n",
    "\n",
    "    fila = leer_entero(f\"Fila (1-{FILAS}): \", 1, FILAS)\n",
    "    espacio = leer_entero(f\"Espacio (1-{COLUMNAS}): \", 1, COLUMNAS)\n",
    "    if matriz[fila - 1][espacio - 1] != LIBRE:\n",
    "        print(f\"  ⚠ Ese lugar está ocupado por {matriz[fila - 1][espacio - 1]}.\")\n",
    "        return\n",
    "\n",
    "    print(\"  1) Motocicleta  2) Automóvil  3) Camioneta  4) Camión\")\n",
    "    tipo = TIPOS[leer_entero(\"  Tipo de vehículo (1-4): \", 1, 4)]\n",
    "    entrada = leer_hora(\"Hora de entrada (HH:MM): \")\n",
    "\n",
    "    matriz[fila - 1][espacio - 1] = placa\n",
    "    registros.append({\n",
    "        \"espacio\": (fila - 1) * COLUMNAS + espacio,\n",
    "        \"placa\": placa, \"tipo\": tipo, \"entrada\": entrada,\n",
    "        \"salida\": None, \"permanencia\": None, \"importe\": None,\n",
    "    })\n",
    "    print(f\"  ✔ {placa} registrado en el espacio {(fila - 1) * COLUMNAS + espacio}.\")\n",
    "\n",
    "\n",
    "def consultar_ubicacion(matriz):\n",
    "    placa = input(\"Placa: \").strip().upper()\n",
    "    ubicacion = buscar_placa(matriz, placa)\n",
    "    if ubicacion is None:\n",
    "        print(f\"  La placa {placa} no se encuentra en el estacionamiento.\")\n",
    "    else:\n",
    "        print(f\"  {placa} está en fila {ubicacion[0] + 1}, espacio {ubicacion[1] + 1}.\")\n",
    "\n",
    "\n",
    "def registrar_salida(matriz, registros):\n",
    "    placa = input(\"Placa del vehículo que sale: \").strip().upper()\n",
    "    ubicacion = buscar_placa(matriz, placa)\n",
    "    if ubicacion is None:\n",
    "        print(f\"  ⚠ La placa {placa} no se encuentra en el estacionamiento.\")\n",
    "        return\n",
    "\n",
    "    # localizar su registro (el que aún no tiene salida)\n",
    "    for registro in registros:\n",
    "        if registro[\"placa\"] == placa and registro[\"salida\"] is None:\n",
    "            break\n",
    "\n",
    "    salida = leer_hora(\"Hora de salida (HH:MM): \", minimo=registro[\"entrada\"])\n",
    "    permanencia = salida - registro[\"entrada\"]\n",
    "    horas_cobradas = max(1, math.ceil(permanencia / 60))\n",
    "    importe = TARIFAS[registro[\"tipo\"]] * horas_cobradas\n",
    "\n",
    "    registro[\"salida\"] = salida\n",
    "    registro[\"permanencia\"] = permanencia\n",
    "    registro[\"importe\"] = importe\n",
    "    matriz[ubicacion[0]][ubicacion[1]] = LIBRE      # se libera el espacio\n",
    "\n",
    "    print(f\"  ✔ Salida de {placa} ({registro['tipo']})\")\n",
    "    print(f\"    Permanencia: {formato_duracion(permanencia)}\")\n",
    "    print(f\"    Importe a pagar: ${importe:,.2f}\")\n",
    "\n",
    "\n",
    "def mostrar_tabla(registros):\n",
    "    if len(registros) == 0:\n",
    "        print(\"  Aún no hay registros.\")\n",
    "        return\n",
    "    print(f\"\\n{'Espacio':<9}{'Placa':<10}{'Tipo':<13}{'Entrada':<9}{'Salida':<9}{'Permanencia':<13}{'Importe':>10}\")\n",
    "    for r in registros:\n",
    "        salida = formato_hora(r[\"salida\"]) if r[\"salida\"] is not None else \"—\"\n",
    "        permanencia = formato_duracion(r[\"permanencia\"]) if r[\"permanencia\"] is not None else \"—\"\n",
    "        importe = f\"${r['importe']:,.2f}\" if r[\"importe\"] is not None else \"—\"\n",
    "        print(f\"{r['espacio']:<9}{r['placa']:<10}{r['tipo']:<13}{formato_hora(r['entrada']):<9}\"\n",
    "              f\"{salida:<9}{permanencia:<13}{importe:>10}\")\n",
    "\n",
    "# NUEVO: reporte de ocupación e ingresos\n",
    "def mostrar_reporte(matriz, registros):\n",
    "    dentro = [r for r in registros if r[\"salida\"] is None]\n",
    "    con_salida = [r for r in registros if r[\"salida\"] is not None]\n",
    "\n",
    "    # ocupación por fila (ciclos anidados)\n",
    "    ocupacion_por_fila = []\n",
    "    for fila in matriz:\n",
    "        ocupados = 0\n",
    "        for celda in fila:\n",
    "            if celda != LIBRE:\n",
    "                ocupados += 1\n",
    "        ocupacion_por_fila.append(ocupados)\n",
    "    total_ocupados = sum(ocupacion_por_fila)\n",
    "\n",
    "    # ingresos por tipo de vehículo\n",
    "    conteo_tipos = {}\n",
    "    for r in registros:\n",
    "        conteo_tipos[r[\"tipo\"]] = conteo_tipos.get(r[\"tipo\"], 0) + 1\n",
    "\n",
    "    print(\"\\n============ REPORTE DE LA JORNADA ============\")\n",
    "    print(\"1. Vehículos dentro del estacionamiento:\")\n",
    "    if len(dentro) == 0:\n",
    "        print(\"   (ninguno)\")\n",
    "    for r in dentro:\n",
    "        print(f\"   - {r['placa']} ({r['tipo']}) en el espacio {r['espacio']}\")\n",
    "\n",
    "    print(f\"2. Espacios ocupados: {total_ocupados} | libres: {FILAS * COLUMNAS - total_ocupados}\")\n",
    "    print(f\"3. Total de vehículos atendidos: {len(registros)} (con salida registrada: {len(con_salida)})\")\n",
    "    print(f\"4. Ingresos generados: ${sum(r['importe'] for r in con_salida):,.2f}\")\n",
    "\n",
    "    if len(conteo_tipos) == 0:\n",
    "        print(\"5. Tipo de vehículo con más ingresos: (sin datos)\")\n",
    "    else:\n",
    "        mayor = max(conteo_tipos.values())\n",
    "        tipos = [t for t, c in conteo_tipos.items() if c == mayor]\n",
    "        print(f\"5. Tipo de vehículo con más ingresos: {', '.join(tipos)} ({mayor})\")\n",
    "\n",
    "    mayor_fila = max(ocupacion_por_fila)\n",
    "    if mayor_fila == 0:\n",
    "        print(\"6. Fila con mayor ocupación: (todas vacías)\")\n",
    "    else:\n",
    "        filas = [str(n) for n, o in enumerate(ocupacion_por_fila, start=1) if o == mayor_fila]\n",
    "        print(f\"6. Fila con mayor ocupación: {', '.join(filas)} ({mayor_fila} vehículo(s))\")\n",
    "\n",
    "\n",
    "# ---------------- Programa principal ----------------\n",
    "while True:\n",
    "    print(\"\\n1) Registrar entrada\")\n",
    "    print(\"2) Consultar ubicación de una placa\")\n",
    "    print(\"3) Registrar salida y cobrar\")\n",
    "    print(\"4) Ver tabla de registros\")\n",
    "    print(\"5) Ver estacionamiento\")\n",
    "    print(\"6) Reporte de ocupación e ingresos\")\n",
    "    print(\"0) Salir\")\n",
    "    opcion = leer_entero(\"Opción: \", 0, 6)\n",
    "\n",
    "    if opcion == 0:\n",
    "        break\n",
    "    elif opcion == 1:\n",
    "        registrar_entrada(estacionamiento, registros)\n",
    "    elif opcion == 2:\n",
    "        consultar_ubicacion(estacionamiento)\n",
    "    elif opcion == 3:\n",
    "        registrar_salida(estacionamiento, registros)\n",
    "    elif opcion == 4:\n",
    "        mostrar_tabla(registros)\n",
    "    elif opcion == 5:\n",
    "        mostrar_estacionamiento(estacionamiento)\n",
    "    else:\n",
    "        mostrar_reporte(estacionamiento, registros)\n",
    "\n",
    "# NUEVO: al finalizar la jornada se imprime el reporte\n",
    "mostrar_reporte(estacionamiento, registros)"
