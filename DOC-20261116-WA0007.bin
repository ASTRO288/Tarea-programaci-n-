    "# Nivel 3. Estructuras repetitivas"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Ejercicio 7. Atención de varios vehículos  `R`\n",
    "Pedir placa, tipo y horas de cada vehículo, mostrar su importe y repetir hasta que el encargado ya no quiera registrar más. No se guardan los datos."
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# Ejercicio 7. Atención de varios vehículos\n",
    "import math\n",
    "def leer_numero(mensaje):\n",
    "    \"\"\"Pide un número (>= 0) hasta que el dato sea válido.\"\"\"\n",
    "    while True:\n",
    "        try:\n",
    "            valor = float(input(mensaje))\n",
    "            if math.isfinite(valor) and valor >= 0:\n",
    "                return valor\n",
    "        except ValueError:\n",
    "            pass\n",
    "        print(\"  ⚠ Ingresa un número válido (mayor o igual a 0).\")\n",
    "def leer_entero(mensaje, minimo, maximo):\n",
    "    \"\"\"Pide un entero entre minimo y maximo (inclusive).\"\"\"\n",
    "    while True:\n",
    "        try:\n",
    "            valor = int(input(mensaje))\n",
    "            if minimo <= valor <= maximo:\n",
    "                return valor\n",
    "        except ValueError:\n",
    "            pass\n",
    "        print(f\"  ⚠ Ingresa un número entero entre {minimo} y {maximo}.\")\n",
    "def confirmar(mensaje):\n",
    "    \"\"\"Regresa True si el usuario responde que sí.\"\"\"\n",
    "    return input(f\"{mensaje} (s/n): \").strip().lower() in (\"s\", \"si\", \"sí\")\n",
    "while True:\n",
    "    placa = input(\"\\nPlaca: \").strip().upper()\n",
    "    print(\"  1) Motocicleta  2) Automóvil  3) Camioneta  4) Camión\")\n",
    "    opcion = leer_entero(\"  Tipo de vehículo (1-4): \", 1, 4)\n",
    "    if opcion == 1:\n",
    "        tipo, tarifa = \"Motocicleta\", 10\n",
    "    elif opcion == 2:\n",
    "        tipo, tarifa = \"Automóvil\", 15\n",
    "    elif opcion == 3:\n",
    "        tipo, tarifa = \"Camioneta\", 20\n",
    "    else:\n",
    "        tipo, tarifa = \"Camión\", 30\n",
    "    horas = leer_numero(\"  Horas de estancia: \")\n",
    "\n",
    "    importe = tarifa * max(1, math.ceil(horas))\n",
    "    print(f\"  → {placa} ({tipo}): ${importe:,.2f}\")\n",
    "\n",
    "    if not confirmar(\"¿Registrar otro vehículo?\"):\n",
    "        break"
   ],
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Ejercicio 8. Corte de caja  `C` (continúa el ejercicio 7)\n",
    "Se agregan **acumuladores** para el total de vehículos, cantidad por tipo e importe recaudado."
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# Ejercicio 8. Corte de caja  (ejercicio 7 + acumuladores)\n",
    "import math\n",
    "def leer_numero(mensaje):\n",
    "    \"\"\"Pide un número (>= 0) hasta que el dato sea válido.\"\"\"\n",
    "    while True:\n",
    "        try:\n",
    "            valor = float(input(mensaje))\n",
    "            if math.isfinite(valor) and valor >= 0:\n",
    "                return valor\n",
    "        except ValueError:\n",
    "            pass\n",
    "        print(\"  ⚠ Ingresa un número válido (mayor o igual a 0).\")\n",
    "def leer_entero(mensaje, minimo, maximo):\n",
    "    \"\"\"Pide un entero entre minimo y maximo (inclusive).\"\"\"\n",
    "    while True:\n",
    "        try:\n",
    "            valor = int(input(mensaje))\n",
    "            if minimo <= valor <= maximo:\n",
    "                return valor\n",
    "        except ValueError:\n",
    "            pass\n",
    "        print(f\"  ⚠ Ingresa un número entero entre {minimo} y {maximo}.\")\n",
    "def confirmar(mensaje):\n",
    "    \"\"\"Regresa True si el usuario responde que sí.\"\"\"\n",
    "    return input(f\"{mensaje} (s/n): \").strip().lower() in (\"s\", \"si\", \"sí\")\n",
    "# NUEVO: acumuladores\n",
    "total_vehiculos = 0\n",
    "motocicletas = automoviles = camionetas = camiones = 0\n",
    "total_recaudado = 0\n",
    "\n",
    "while True:\n",
    "    placa = input(\"\\nPlaca: \").strip().upper()\n",
    "    print(\"  1) Motocicleta  2) Automóvil  3) Camioneta  4) Camión\")\n",
    "    opcion = leer_entero(\"  Tipo de vehículo (1-4): \", 1, 4)\n",
    "    if opcion == 1:\n",
    "        tipo, tarifa = \"Motocicleta\", 10\n",
    "    elif opcion == 2:\n",
    "        tipo, tarifa = \"Automóvil\", 15\n",
    "    elif opcion == 3:\n",
    "        tipo, tarifa = \"Camioneta\", 20\n",
    "    else:\n",
    "        tipo, tarifa = \"Camión\", 30\n",
    "    horas = leer_numero(\"  Horas de estancia: \")\n",
    "\n",
    "    importe = tarifa * max(1, math.ceil(horas))\n",
    "    print(f\"  → {placa} ({tipo}): ${importe:,.2f}\")\n",
    "\n",
    "    # NUEVO: actualizar acumuladores\n",
    "    total_vehiculos += 1\n",
    "    total_recaudado += importe\n",
    "    if tipo == \"Motocicleta\":\n",
    "        motocicletas += 1\n",
    "    elif tipo == \"Automóvil\":\n",
    "        automoviles += 1\n",
    "    elif tipo == \"Camioneta\":\n",
    "        camionetas += 1\n",
    "    else:\n",
    "        camiones += 1\n",
    "\n",
    "    if not confirmar(\"¿Registrar otro vehículo?\"):\n",
    "        break\n",
    "\n",
    "# NUEVO: corte de caja\n",
    "print(\"\\n========== CORTE DE CAJA ==========\")\n",
    "print(f\"Vehículos atendidos: {total_vehiculos}\")\n",
    "print(f\"  Motocicletas: {motocicletas}\")\n",
    "print(f\"  Automóviles:  {automoviles}\")\n",
    "print(f\"  Camionetas:   {camionetas}\")\n",
    "print(f\"  Camiones:     {camiones}\")\n",
    "print(f\"Total recaudado: ${total_recaudado:,.2f}\")"
   ],
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Ejercicio 9. Control de capacidad  `C` (continúa el ejercicio 8)\n",
    "Capacidad máxima de 30 vehículos: se muestran los espacios disponibles y se detiene el registro cuando se llena."
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# Ejercicio 9. Control de capacidad  (ejercicio 8 + límite de 30 vehículos)\n",
    "import math\n",
    "\n",
    "CAPACIDAD = 30   # NUEVO\n",
    "def leer_numero(mensaje):\n",
    "    \"\"\"Pide un número (>= 0) hasta que el dato sea válido.\"\"\"\n",
    "    while True:\n",
    "        try:\n",
    "            valor = float(input(mensaje))\n",
    "            if math.isfinite(valor) and valor >= 0:\n",
    "                return valor\n",
    "        except ValueError:\n",
    "            pass\n",
    "        print(\"  ⚠ Ingresa un número válido (mayor o igual a 0).\")\n",
    "def leer_entero(mensaje, minimo, maximo):\n",
    "    \"\"\"Pide un entero entre minimo y maximo (inclusive).\"\"\"\n",
    "    while True:\n",
    "        try:\n",
    "            valor = int(input(mensaje))\n",
    "            if minimo <= valor <= maximo:\n",
    "                return valor\n",
    "        except ValueError:\n",
    "            pass\n",
    "        print(f\"  ⚠ Ingresa un número entero entre {minimo} y {maximo}.\")\n",
    "def confirmar(mensaje):\n",
    "    \"\"\"Regresa True si el usuario responde que sí.\"\"\"\n",
    "    return input(f\"{mensaje} (s/n): \").strip().lower() in (\"s\", \"si\", \"sí\")\n",
    "total_vehiculos = 0\n",
    "motocicletas = automoviles = camionetas = camiones = 0\n",
    "total_recaudado = 0\n",
    "\n",
    "while True:\n",
    "    print(f\"\\n--- Vehículo #{total_vehiculos + 1} ---\")\n",
    "    placa = input(\"Placa: \").strip().upper()\n",
    "    print(\"  1) Motocicleta  2) Automóvil  3) Camioneta  4) Camión\")\n",
    "    opcion = leer_entero(\"  Tipo de vehículo (1-4): \", 1, 4)\n",
    "    if opcion == 1:\n",
    "        tipo, tarifa = \"Motocicleta\", 10\n",
    "    elif opcion == 2:\n",
    "        tipo, tarifa = \"Automóvil\", 15\n",
    "    elif opcion == 3:\n",
    "        tipo, tarifa = \"Camioneta\", 20\n",
    "    else:\n",
    "        tipo, tarifa = \"Camión\", 30\n",
    "    horas = leer_numero(\"  Horas de estancia: \")\n",
    "\n",
    "    importe = tarifa * max(1, math.ceil(horas))\n",
    "    print(f\"  → {placa} ({tipo}): ${importe:,.2f}\")\n",
    "\n",
    "    total_vehiculos += 1\n",
    "    total_recaudado += importe\n",
    "    if tipo == \"Motocicleta\":\n",
    "        motocicletas += 1\n",
    "    elif tipo == \"Automóvil\":\n",
    "        automoviles += 1\n",
    "    elif tipo == \"Camioneta\":\n",
    "        camionetas += 1\n",
    "    else:\n",
    "        camiones += 1\n",
    "\n",
    "    # NUEVO: control de capacidad\n",
    "    disponibles = CAPACIDAD - total_vehiculos\n",
    "    print(f\"  Espacios disponibles: {disponibles}\")\n",
    "    if disponibles == 0:\n",
    "        print(\"  ⛔ Capacidad máxima alcanzada: no es posible recibir más vehículos.\")\n",
    "        break\n",
    "\n",
    "    if not confirmar(\"¿Registrar otro vehículo?\"):\n",
    "        break\n",
    "\n",
    "print(\"\\n========== CORTE DE CAJA ==========\")\n",
    "print(f\"Vehículos atendidos: {total_vehiculos}\")\n",
    "print(f\"  Motocicletas: {motocicletas}\")\n",
